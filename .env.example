# 공개 웹사이트에 연결할 도메인 (DNS A 레코드를 서버 IP로 연결)
DOMAIN=example.com

# MySQL 계정 및 비밀번호를 실제 값으로 변경
DB_USERNAME=it_academy
DB_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
DB_ROOT_PASSWORD=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_PASSWORD

# 프론트엔드와 백엔드가 같은 도메인을 사용하므로 기본값을 유지해도 됩니다.
CORS_ALLOWED_ORIGINS=https://example.com
