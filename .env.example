# 공개 웹사이트 도메인
DOMAIN=example.com

# MySQL 계정 및 비밀번호를 실제 값으로 변경
DB_USERNAME=it_academy
DB_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
DB_ROOT_PASSWORD=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_PASSWORD

# 최초 최고 관리자 계정. 실제 값으로 변경하고 외부에 공유하지 마세요.
ADMIN_INITIAL_LOGIN_ID=siteadmin
ADMIN_INITIAL_PASSWORD=CHANGE_THIS_TO_A_UNIQUE_LONG_RANDOM_PASSWORD
ADMIN_INITIAL_NAME=최고 관리자

# 같은 도메인으로 프론트엔드와 API를 제공하는 기본 구성
CORS_ALLOWED_ORIGINS=https://example.com
